#include <windows.h>
#include "../src/app/Version.h"

1 ICON "skiff.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SKIFF_WIN_FILEVER
 PRODUCTVERSION SKIFF_WIN_FILEVER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Skiff"
            VALUE "FileDescription", "Skiff"
            VALUE "FileVersion", SKIFF_WIN_VERSTR
            VALUE "InternalName", "Skiff"
            VALUE "OriginalFilename", "Skiff.exe"
            VALUE "ProductName", "Skiff"
            VALUE "ProductVersion", SKIFF_WIN_VERSTR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
