prefix=D:/WorkBuddy_Work/SSH_mobile/Skiff/win/third_party/libssh2-install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libssh2
URL: https://libssh2.org/
Description: Library for SSH-based communication
Version: 1.11.1
Requires: 
Requires.private: 
Libs: -L${libdir} -lssh2 -lws2_32 -lcrypt32 -lbcrypt
Libs.private: -lws2_32 -lcrypt32 -lbcrypt
Cflags: -I${includedir}
